    "# Function to clean the text in the DataFrame\n",
    "def clean_texts(df, text_column='Essay'):\n",
    "    # Define a function to clean individual text entries\n",
    "    def clean_text(text):\n",
    "        # Convert text to lowercase\n",
    "        text = text.lower()\n",
    "        # Remove special characters and numbers (except for basic punctuation)\n",
    "        text = re.sub(r'[^a-zA-Z\\s]', '', text)\n",
    "        # Remove extra whitespace\n",
    "        text = re.sub(r'\\s+', ' ', text).strip()\n",
    "        return text\n",
    "\n",
    "    # Apply the cleaning function to the specified text column\n",
    "    df[text_column] = df[text_column].apply(lambda x: clean_text(str(x)))\n",
    "\n",
    "    return df\n",
    "\n",
    "# Function to clean and save each essay\n",
    "def save_essays(df):\n",
    "    # Clean the texts first\n",
    "    df = clean_texts(df, text_column='Essay')\n",
    "\n",
    "    # Ensure that 'Overall' has no missing values\n",
    "    df['Overall'].fillna('No_Overall_Score', inplace=True)\n",
    "\n",
    "    for index, row in df.iterrows():\n",
    "        # Extracting data from the row\n",
    "        task_type = row.get('Task_Type', 'Unknown_Task_Type')\n",
    "        overall_score = row['Overall']  # Read the 'Overall' score directly from the row\n",
    "        essay_id = index  # Use the row index as a unique identifier for Essay_ID\n",
    "\n",
    "        # Calculate word count of the essay\n",
    "        essay_text = row.get('Essay', 'No_Essay_Text')\n",
    "        word_count = len(essay_text.split())\n",
    "\n",
    "        # Create the directory for the task type if it doesn't exist\n",
    "        directory = f'TaskType_{task_type}/'\n",
    "        os.makedirs(directory, exist_ok=True)\n",
    "\n",
    "        # Construct the filename using the 'Overall' score\n",
    "        filename = f'{directory}TaskType_{task_type}_Overall_{overall_score}_EssayID_{essay_id}.txt'\n",
    "\n",
    "        # Print the filename to ensure correctness\n",
    "        print(f\"Creating file: {filename}\")\n",
    "\n",
    "        # Write the essay and metadata to the file\n",
    "        with open(filename, 'w') as file:\n",
    "            # Write specific columns to the header section\n",
    "            file.write(f'Task Type: {task_type}\\n')\n",
    "            file.write(f'Question: {row.get(\"Question\", \"Unknown_Question\")}\\n')\n",
