    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "import re\n",
    "import seaborn as sns\n",
    "\n",
    "# Load the dataset (adjust the path to your dataset)\n",
    "df = pd.read_csv(\"ielts_writing_dataset.csv\")\n",
    "\n",
    "# Clean the text and add a 'Cleaned_Essay_Text' column if it doesn't exist\n",
    "def clean_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'\\s+', ' ', text)\n",
    "    text = re.sub(r'[^\\w\\s]', '', text)\n",
    "    return text\n",
    "\n",
    "if 'Cleaned_Essay_Text' not in df.columns:\n",
    "    df['Cleaned_Essay_Text'] = df['Essay'].apply(clean_text)\n",
    "\n",
    "# Calculate word count for each essay\n",
    "df['Word_Count'] = df['Cleaned_Essay_Text'].apply(lambda x: len(x.split()))\n",
    "\n",
    "# Group by Task_Type and Overall to count the number of essays for each combination\n",
    "grouped = df.groupby(['Task_Type', 'Overall']).size().unstack(fill_value=0)\n",
    "\n",
    "# Plot 1: Number of Essays per Task Type and Overall Score with data labels\n",
    "plt.figure(figsize=(12, 8))\n",
    "colors = sns.color_palette(\"tab10\", n_colors=len(grouped.columns))\n",
    "grouped.plot(kind='bar', stacked=True, colormap='tab10', figsize=(12, 8), color=colors)\n",
    "plt.title('Number of Essays per Task Type and Overall Score', fontsize=16)\n",
    "plt.xlabel('Task Type', fontsize=14)\n",
    "plt.ylabel('Number of Essays', fontsize=14)\n",
    "plt.xticks(rotation=0, fontsize=12)\n",
    "plt.yticks(fontsize=12)\n",
    "plt.legend(title='Overall Score', bbox_to_anchor=(1.05, 1), loc='upper left', fontsize=12)\n",
    "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
    "for n, x in enumerate(grouped.index):\n",
    "    for (i, y) in enumerate(grouped.iloc[n]):\n",
    "        if y > 0:  # Only label non-zero values\n",
    "            plt.text(n, y + sum(grouped.iloc[n, :i]), str(int(y)), ha='center', va='bottom', fontsize=10)\n",
